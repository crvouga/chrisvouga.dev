{
  "name": "infra",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run ci:format && turbo run tc lint test build",
    "check:vault-secrets": "vault run --config dev -- bun run scripts/check-vault-secrets.ts",
    "check:vault-secrets:prd": "vault run --config prd -- bun run scripts/check-vault-secrets.ts",
    "ci:format": "prettier --check .",
    "cleanup-railway-deployments": "bun run scripts/cleanup-railway-deployments.ts",
    "deploy": "echo 'Hosting is via infra — push main runs ci-turborepo.yml'",
    "deploy-railway": "bun run scripts/deploy-railway.ts",
    "destroy-digitalocean": "bun run scripts/destroy-digitalocean.ts",
    "destroy-fly": "bun run scripts/destroy-fly.ts",
    "destroy-railway": "bun run scripts/destroy-railway.ts",
    "dev": "bun run --filter @apps/api dev",
    "format": "prettier --write .",
    "gh": "open https://github.com/crvouga/infra/actions",
    "gh:ci": "open https://github.com/crvouga/infra/actions/workflows/ci-turborepo.yml",
    "health-check": "bun run scripts/health-check-urls.ts",
    "make-ghcr-public": "bun run scripts/make-ghcr-public.ts",
    "print-platform-env": "bun run scripts/print-platform-env.ts",
    "provision-railway": "bun run scripts/provision-railway.ts",
    "rename-railway": "bun run scripts/rename-railway.ts",
    "rollout-publish": "bun run scripts/rollout-publish-workflows.ts",
    "seed": "bun run scripts/ensure-vault-secrets.ts",
    "seed:turbo-client": "vault run --config dev -- bun run scripts/seed-turbo-client-secrets.ts",
    "seed:turbo-client:mirror-prd": "bun run scripts/seed-turbo-client-secrets.ts -- --mirror-prd",
    "seed:turbo-client:prd": "vault run --config prd -- bun run scripts/seed-turbo-client-secrets.ts",
    "seed-vault-github-secret": "bun run scripts/seed-vault-github-secret.ts",
    "setup": "VAULT_CONFIG=dev bun run --filter @apps/api setup && bun run scripts/ensure-vault-secrets.ts",
    "smoke": "vault run --config dev -- bun run scripts/smoke-test-cache.ts",
    "smoke:prd": "vault run --config prd -- bun run scripts/smoke-test-cache.ts",
    "sync-aliases": "bun run scripts/sync-aliases.ts",
    "sync-dns": "bun run scripts/sync-dns.ts",
    "sync-railway-secrets": "bun run scripts/sync-railway-secrets.ts",
    "sync-redirects": "bun run scripts/sync-redirects.ts",
    "test:scripts": "bun test scripts",
    "typecheck": "tsc --noEmit",
    "vault:login": "vault login --method=userpass username=crvouga",
    "workstation:setup": "bun run packages/workstation/setup.ts"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-lingui": "catalog:",
    "eslint-plugin-naming": "catalog:",
    "eslint-plugin-no-only-tests": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22"
  },
  "catalog": {
    "@types/bun": "^1.3.9",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "aws4fetch": "^1.0.20",
    "bun-types": "^1.3.9",
    "eslint": "^9.25.0",
    "eslint-plugin-lingui": "^0.13.1",
    "eslint-plugin-naming": "^0.1.10",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hono": "^4.7.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.4",
    "turbo": "^2.9.16",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.1",
    "yaml": "^2.9.0"
  }
}
