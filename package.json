{
  "name": "infra",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run ci:install && bun run ci:format && turbo run tc lint test build",
    "check:ci": "bun run ci:install && bun run check:vault-secrets && bun run check:smoke:secrets && bun run check",
    "check:smoke:secrets": "vault run --config dev -- bun run --filter @pkgs/api smoke:secrets",
    "check:vault-secrets": "vault run --config dev -- bun run --filter @pkgs/api check:vault-secrets",
    "check:vault-secrets:prd": "vault run --config prd -- bun run --filter @pkgs/api check:vault-secrets",
    "ci:format": "prettier --check .",
    "ci:install": "bun install --frozen-lockfile",
    "cleanup-railway-deployments": "bun run --filter @pkgs/infra cleanup-railway-deployments",
    "deploy": "echo 'Hosting is via infra — push main runs ci-turborepo.yml'",
    "deploy-railway": "bun run --filter @pkgs/infra deploy-railway",
    "destroy-digitalocean": "bun run --filter @pkgs/infra destroy-digitalocean",
    "destroy-fly": "bun run --filter @pkgs/infra destroy-fly",
    "destroy-railway": "bun run --filter @pkgs/infra destroy-railway",
    "dev": "bun run --filter @pkgs/api dev",
    "format": "prettier --write .",
    "gh": "open https://github.com/crvouga/workspace/actions",
    "gh:ci": "open https://github.com/crvouga/workspace/actions/workflows/ci-turborepo.yml",
    "gh:ci:log": "gh run view \"$(gh run list --workflow ci-turborepo.yml --limit 1 --json databaseId --jq '.[0].databaseId')\" --log-failed",
    "gh:ci:status": "gh run list --workflow ci-turborepo.yml --limit 3",
    "gh:ci:watch": "gh run watch \"$(gh run list --workflow ci-turborepo.yml --limit 1 --json databaseId --jq '.[0].databaseId')\" --exit-status",
    "health-check": "bun run --filter @pkgs/infra health-check",
    "list-deploy-service-ids": "bun run --filter @pkgs/infra list-deploy-service-ids",
    "make-ghcr-public": "bun run --filter @pkgs/infra make-ghcr-public",
    "print-platform-env": "bun run --filter @pkgs/infra print-platform-env",
    "provision-railway": "bun run --filter @pkgs/infra provision-railway",
    "rename-railway": "bun run --filter @pkgs/infra rename-railway",
    "rollout-publish": "bun run --filter @pkgs/infra rollout-publish",
    "seed": "bun run --filter @pkgs/api seed",
    "seed:turbo-client": "vault run --config dev -- bun run --filter @pkgs/api seed:turbo-client",
    "seed:turbo-client:mirror-prd": "bun run --filter @pkgs/api seed:turbo-client -- --mirror-prd",
    "seed:turbo-client:prd": "vault run --config prd -- bun run --filter @pkgs/api seed:turbo-client",
    "seed-vault-github-secret": "bun run --filter @pkgs/infra seed-vault-github-secret",
    "setup": "VAULT_CONFIG=dev bun run --filter @pkgs/api setup && bun run --filter @pkgs/api seed",
    "smoke": "vault run --config dev -- bun run --filter @pkgs/api smoke",
    "smoke:prd": "vault run --config prd -- bun run --filter @pkgs/api smoke",
    "sync-aliases": "bun run --filter @pkgs/infra sync-aliases",
    "sync-dns": "bun run --filter @pkgs/infra sync-dns",
    "sync-railway-secrets": "bun run --filter @pkgs/infra sync-railway-secrets",
    "sync-redirects": "bun run --filter @pkgs/infra sync-redirects",
    "tc": "turbo run tc",
    "typecheck": "tsc --noEmit",
    "vault:login": "vault login --method=userpass username=crvouga",
    "opencode:setup": "bun run packages/workstation/setup.ts",
    "workstation:setup": "bun run packages/workstation/setup.ts",
    "workstation:configure:opencode": "bun run --filter @pkgs/workstation configure:opencode"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-lingui": "catalog:",
    "eslint-plugin-naming": "catalog:",
    "eslint-plugin-no-only-tests": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22"
  },
  "catalog": {
    "@types/bun": "^1.3.9",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "aws4fetch": "^1.0.20",
    "bun-types": "^1.3.9",
    "eslint": "^9.25.0",
    "eslint-plugin-lingui": "^0.13.1",
    "eslint-plugin-naming": "^0.1.10",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hono": "^4.7.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.4",
    "turbo": "^2.9.16",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.1",
    "yaml": "^2.9.0"
  }
}
