#!/bin/bash
# OpenCode notification click handler — focus the correct VS Code window, then
# the opencode terminal editor tab running the session that needs attention.
#
# Usage: focus-opencode --kind <finished|question|permission|error> \
#                       --session <id> --dir <project-dir> [--title <session-title>] \
#                       [--token <short-session-token>]
#
# The plugin tags its controlling terminal's title with the per-session token
# at notification time, so the tab is matched exactly (not by fuzzy session
# title). Best-effort by design: every step degrades gracefully, never blocks,
# and exits 0. Keystrokes require a one-time Accessibility + Automation grant
# for OpenCodeNotifier (System Settings → Privacy & Security); without it the
# correct VS Code window is still focused via the `code` CLI (no permissions).

set -u

kind="" session="" dir="" title="" token=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --kind) kind="${2:-}"; shift 2 ;;
    --session) session="${2:-}"; shift 2 ;;
    --dir) dir="${2:-}"; shift 2 ;;
    --title) title="${2:-}"; shift 2 ;;
    --token) token="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done

[[ -n "$dir" ]] || exit 0

# Exact-match target for the terminal tab: the per-session token the plugin
# wrote into the terminal title at notification time. Older banners without a
# token fall back to the session title, then the process name.
target="$token"
[[ -n "$target" ]] || target="$title"
[[ -n "$target" ]] || target="opencode"

# 1. Focus (or open) the VS Code window for this project, reusing the existing
#    window. `code` returns before the window is frontmost, so poll for it
#    instead of a fixed sleep — typing into the tab picker before Code is
#    front was the main focus flake.
command -v code >/dev/null 2>&1 && code -r "$dir" 2>/dev/null
for _ in $(seq 1 40); do
  front="$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null)" || front=""
  [[ "$front" == "Code" ]] && break
  sleep 0.1
done

# 2. Focus the opencode terminal editor tab via the editor quick pick
#    (ctrl+tab → type-ahead → Enter). The token is unique per session, so the
#    pick matches exactly one tab. Skipped when the tagged terminal is already
#    the active editor (detected from the window title), which also guarantees
#    the typed target never lands inside the TUI prompt input. Verified after
#    picking, with one retry.
FOCUS_TARGET="$target" osascript <<'APPLESCRIPT' 2>/dev/null || \
  echo "focus-opencode: keystrokes skipped (grant Accessibility/Automation to OpenCodeNotifier)" >&2
on run
  set target to system attribute "FOCUS_TARGET"
  tell application "System Events"
    if name of first application process whose frontmost is true is not "Code" then return "abort"
    if name of front window of process "Code" contains target then return "already"
    repeat 2 times
      keystroke tab using control down
      delay 0.6
      keystroke target
      delay 0.3
      keystroke return
      delay 0.5
      if name of front window of process "Code" contains target then return "ok"
    end repeat
    return "miss"
  end tell
end run
APPLESCRIPT

exit 0
