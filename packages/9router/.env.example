# Copy to .env and fill secrets (or: npm run pull-secrets)
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production
# Always set DATA_DIR here so ambient shell DATA_DIR from other projects is ignored.
DATA_DIR=./data
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:20128
BASE_URL=http://127.0.0.1:20128
AUTH_COOKIE_SECURE=false

# Cursor BYOK defaults to https://9router.chrisvouga.dev (named tunnel).
# Override only if needed:
# CURSOR_OPENAI_BASE_URL=https://9router.chrisvouga.dev

JWT_SECRET=
INITIAL_PASSWORD=
API_KEY_SECRET=
MACHINE_ID_SALT=

# Filled by npm run pull-secrets from Vault secret/personal/prd (9ROUTER_* fields).
# Or inject at runtime: vault run -- npm run sync-cursor
# Optional: VAULT_KV_CONFIG=dev
#
# Provider API keys live in Vault (not required in .env). Seed interactively (API keys only):
#   npm run setup-provider-creds
# OAuth: dashboard or npm run sync-providers -- --interactive
# Examples: OPENAI_API_KEY, ANTHROPIC_API_KEY, GLM_API_KEY, MINIMAX_API_KEY, CLOUDFLARE_API_TOKEN
# See providers.yaml (vaultKeyOverrides) and README "Providers (Vault-driven)".
